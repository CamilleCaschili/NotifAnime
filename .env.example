# Scraper (racine du repo) — en CI, ces valeurs viennent des secrets GitHub Actions
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé service_role (pas anon), à garder secrète
SUPABASE_SERVICE_KEY=
# Domaine actuel de voiranime, sans slash final
BASE_URL=https://voir-anime.to
# Optionnel : webhook Discord (le tien) qui reçoit les alertes techniques du
# scraper (domaine qui change, scraping cassé). Jamais envoyées aux utilisateurs.
ADMIN_WEBHOOK_URL=
